# Copia este archivo como `.env` y completa los valores. El archivo `.env` NO se sube al repositorio.

# --- Base de datos: la misma que usa la aplicación Java (application.yaml) ---
DB_NAME=inmovision3d
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=pega-aqui-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- URL donde corre la aplicación Java (fotos y enlaces del mapa) ---
SPRING_BASE_URL=http://localhost:8080
